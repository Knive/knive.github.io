{
    "name": "knive-github-io",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "typecheck": "tsc -b",
        "intro:review": "sh scripts/intro-review/run.sh",
        "scroll:review": "sh scripts/scroll-review/run.sh",
        "prepare": "husky",
        "style:review": "sh scripts/style-review/run.sh",
        "scene:review": "sh scripts/scene-review/run.sh",
        "sections:review": "sh scripts/section-review/run.sh"
    },
    "dependencies": {
        "@react-three/drei": "^10.7.9",
        "@react-three/fiber": "^9.8.1",
        "@react-three/postprocessing": "^3.2.2",
        "@tailwindcss/vite": "^4.3.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "gsap": "^3.15.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "three": "^0.186.1"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@commitlint/types": "^21.2.3",
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@types/three": "^0.186.0",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "lint-staged": "^17.6.0",
        "prettier": "3.9.10",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.71.2",
        "vite": "^8.3.0"
    },
    "lint-staged": {
        "*.{ts,tsx,js}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{css,json,md,html}": "prettier --write"
    },
    "packageManager": "pnpm@10.33.0"
}
